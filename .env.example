# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.
DB_URL=jdbc:postgresql://localhost:5432/gymflow
DB_USER=gymflow
DB_PASSWORD=cambia-esta-password
# Mínimo 32 caracteres. Generar: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:4200
# Solo con SPRING_PROFILES_ACTIVE=demo
DEMO_PASSWORD=Admin123!
